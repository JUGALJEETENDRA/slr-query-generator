# Copy these values into the environment on the 128 GB laptop before starting.
# The 8 GB laptop never needs the weights or this profile.
LOCAL_MODEL=gpt-oss:20b
GPT_OSS_MODEL=gpt-oss:20b
OLLAMA_HOST=http://localhost:11434

# Conservative CPU-first settings. 8192 keeps KV-cache memory bounded; tune only
# after the baseline succeeds. Set threads to the physical cores, not logical CPUs.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=768
OLLAMA_NUM_THREAD=8
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT_SECONDS=900

# One large model request at a time prevents RAM spikes and CPU contention.
OLLAMA_MAX_CONCURRENT=1
ENABLE_PARALLEL_SCREENING=false
SCREENING_WORKERS=1
