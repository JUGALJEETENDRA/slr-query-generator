# Skyvern Cloud API access. Copy this file to .env and fill only the services
# your institution is authorized to use.
SKYVERN_API_KEY=

# Credential IDs from the Skyvern credential vault. Public databases may be
# left blank; subscription databases normally require a credential.
SKYVERN_CREDENTIAL_GOOGLE_SCHOLAR=
SKYVERN_CREDENTIAL_SCOPUS=
SKYVERN_CREDENTIAL_WEB_OF_SCIENCE=
SKYVERN_CREDENTIAL_IEEE_XPLORE=
SKYVERN_CREDENTIAL_PUBMED=

# Existing local LitSync services.
OLLAMA_BASE_URL=http://localhost:11434
SEMANTIC_SCHOLAR_API_KEY=
AGENTIC_RQ_MODEL=
